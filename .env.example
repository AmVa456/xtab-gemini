# Gemini API Configuration
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# xTab-Dashboard Integration (Optional)
# Set to true to enable integration with xTab-dashboard
VITE_DASHBOARD_ENABLED=false

# xTab-Dashboard API URL
# The base URL for the xTab-dashboard API (e.g., http://localhost:5000/api)
VITE_DASHBOARD_API_URL=http://localhost:5000/api

# xTab-Dashboard API Key (Optional)
# API key for authenticating with xTab-dashboard
VITE_DASHBOARD_API_KEY=

# App Mode
# Determines how the app runs: 'standalone', 'integrated', or 'embedded'
VITE_MODE=standalone
